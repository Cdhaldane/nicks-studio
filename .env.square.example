# Square Configuration
# Get these from https://developer.squareup.com/apps

# Your Square Application ID
REACT_APP_SQUARE_APPLICATION_ID=sandbox-sq0idb-XXXXXXXXXXXX

# Your Square Location ID
REACT_APP_SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXXXX

# Environment: 'sandbox' for testing, 'production' for live
REACT_APP_SQUARE_ENVIRONMENT=sandbox

# Backend API URL (where your Square proxy server runs)
REACT_APP_API_URL=http://localhost:4001/api

# Server-side only (for squareApi.js backend)
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXXXX
SQUARE_ENVIRONMENT=sandbox
FRONTEND_URL=http://localhost:3002

# Keep these if you want to maintain Shopify as fallback
REACT_APP_SHOPIFY_DOMAIN=your-store.myshopify.com
REACT_APP_SHOPIFY_STOREFRONT_TOKEN=your-token
