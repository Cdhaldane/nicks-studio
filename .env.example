# Spotify API Configuration
SPOTIFY_TOKEN=your_spotify_client_id
SPOTIFY_SECRET=your_spotify_client_secret

# Shopify Configuration
# Get your credentials from Shopify Admin → Apps → Develop apps → Create an app
# Configure Storefront API scopes: unauthenticated_read_product_listings, unauthenticated_read_checkouts
REACT_APP_SHOPIFY_DOMAIN=nickolamagnolia.myshopify.com
REACT_APP_SHOPIFY_STOREFRONT_TOKEN=8e7e244e6bb1154a85685231573b7d3f

# MailChimp Configuration
REACT_APP_MAILCHIMP_URL=your_mailchimp_url

# Supabase Configuration
# Get these values from your Supabase project dashboard
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Newsletter / Resend (server-side only — never prefix these REACT_APP_) ──

# From the Resend dashboard, or auto-added by the Vercel Resend integration.
RESEND_API_KEY=re_your_resend_api_key

# Must be an address on a domain verified in Resend.
NEWSLETTER_FROM=Nickola Magnolia <news@nickolamagnolia.com>
# Where replies land — use a real inbox that is actually read.
NEWSLETTER_REPLY_TO=hello@nickolamagnolia.com

# Resend's free tier allows 100 emails/day. Raise to 3000 on the Pro plan to
# send an entire campaign in one pass instead of dripping it daily.
NEWSLETTER_DAILY_LIMIT=100

# Absolute site origin — used to build unsubscribe links inside emails.
PUBLIC_SITE_URL=https://nickolamagnolia.com

# ── Square (server-side only) ──

# Square Developer dashboard → your app → Credentials.
SQUARE_ACCESS_TOKEN=your_square_access_token
# "production" uses live money; anything else uses the sandbox.
SQUARE_ENVIRONMENT=sandbox
# The location the website sells from. Orders at any other location are ignored
# by the order-alert webhook, so in-person sales don't trigger website emails.
SQUARE_LOCATION_ID=your_square_location_id
# Where Square sends buyers after checkout.
FRONTEND_URL=https://nickolamagnolia.com

# ── Square order alerts (server-side only) ──

# Who gets the "new order" email when a sale comes in. Comma-separated; the shop
# owner belongs here. Leave it unset and no alerts are sent at all.
ORDER_NOTIFY_EMAILS=nickola@example.com,studio@example.com

# ── Admin auth (server-side only) ──

# The admin dashboard password. Previously hardcoded in the JS bundle.
ADMIN_PASSWORD=choose_a_strong_password
# Random 32+ byte secret signing session and unsubscribe tokens.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_random_secret
# Set this in the Vercel dashboard so Cron requests can be authenticated.
CRON_SECRET=generate_a_random_secret
