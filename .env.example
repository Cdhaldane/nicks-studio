# Spotify API Configuration (server-side only — read by api/spotify-stats.js).
# Never prefix the secret REACT_APP_: those values are compiled into the public JS.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Newsletter / Resend (server-side only — never prefix these REACT_APP_) ──

# From the Resend dashboard, or auto-added by the Vercel Resend integration.
RESEND_API_KEY=re_your_resend_api_key

# Must be an address on a domain verified in Resend.
NEWSLETTER_FROM=Nickola Magnolia <news@nickolamagnolia.com>
# Where replies land — use a real inbox that is actually read.
NEWSLETTER_REPLY_TO=hello@nickolamagnolia.com

# Resend's free tier allows 100 emails/day. Raise to 3000 on the Pro plan to
# send an entire campaign in one pass instead of dripping it daily.
NEWSLETTER_DAILY_LIMIT=100

# Campaigns stop 5 short of the ceiling above (so 95/day on the free tier),
# leaving room for test sends and the verification copy. Set this to pin the
# campaign cap to a specific number instead.
# NEWSLETTER_CAMPAIGN_DAILY_LIMIT=95

# A copy goes here with every daily instalment of a campaign, so each day's cron
# run is visible in a real inbox (a 300-person drip at 95/day = 4 copies).
# Charged to the 5 held back above, not to a subscriber's slot.
# Set to an empty value to switch the copies off.
NEWSLETTER_VERIFY_ADDRESS=xcdhaldane@gmail.com

# Absolute site origin — used to build unsubscribe links inside emails.
PUBLIC_SITE_URL=https://nickolamagnolia.com

# ── Square (server-side only) ──

# Square Developer dashboard → your app → Credentials.
SQUARE_ACCESS_TOKEN=your_square_access_token
# "production" uses live money; anything else uses the sandbox.
SQUARE_ENVIRONMENT=sandbox
# The location the website sells from. Orders at any other location are ignored
# by the order-alert webhook, so in-person sales don't trigger website emails.
SQUARE_LOCATION_ID=your_square_location_id
# Where Square sends buyers after checkout.
FRONTEND_URL=https://nickolamagnolia.com

# ── Square order alerts (server-side only) ──

# Who gets the "new order" email when a sale comes in. Comma-separated; the shop
# owner belongs here. Leave it unset and no alerts are sent at all.
ORDER_NOTIFY_EMAILS=nickola@example.com,studio@example.com

# ── Booking request alerts (server-side only) ──

# Who gets the "new booking request" email. Comma-separated. Leave it unset to
# fall back to ORDER_NOTIFY_EMAILS. Replies go straight to the person booking.
BOOKING_NOTIFY_EMAILS=bookings@example.com

# ── Private data storage (server-side only) ──

# The Blob store is public, so the subscriber list, campaign recipient lists and
# booking requests are stored at pathnames derived from this secret, which can't
# be guessed. Generate with: openssl rand -hex 32
#
# - Must be IDENTICAL in Vercel and in any local .env that points at the same
#   Blob store (BLOB_READ_WRITE_TOKEN). An environment with a missing or
#   different value refuses to read the data rather than start an empty list.
# - The first read after it's set moves each document from its old public
#   pathname and leaves a "moved" marker behind.
# - Never change it once set: the data becomes unreachable until it's set back.
BLOB_PATH_SECRET=generate_with_openssl_rand_hex_32

# ── Admin auth (server-side only) ──

# The admin dashboard password. Previously hardcoded in the JS bundle.
ADMIN_PASSWORD=choose_a_strong_password
# Random 32+ byte secret signing session and unsubscribe tokens.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate_a_random_secret
# Set this in the Vercel dashboard so Cron requests can be authenticated.
CRON_SECRET=generate_a_random_secret
